# Copy to .env and fill in real values when moving off mock data (docs/19 Phase 21).
# All EXPO_PUBLIC_ vars are bundled into the client — never put private secrets here.

# When true, api/*.api.ts functions return fixture data from src/mocks/ instead of
# hitting the network. Default true until Phase 21 (Integration).
EXPO_PUBLIC_USE_MOCK_API=true

# Base URL of skincoach-api. Unused while mock mode is on.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Clerk publishable key (safe to expose client-side). Get from https://dashboard.clerk.com
# Use a test-mode instance key until Phase 25 production cutover.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
