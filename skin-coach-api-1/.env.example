# Copy to .env and fill in real values. Never commit secrets (docs/08).

# Postgres — DEV: Supabase (Project Settings → Database → Connection string).
# PROD: Neon (switch is just these two URLs; Prisma treats them identically).
# DATABASE_URL = app runtime connection (pooled on Lambda). For local dev you can
# point it at the direct connection — pooling only matters under Lambda. Append
# ?sslmode=require. Supabase pooled host looks like ...pooler.supabase.com:6543.
DATABASE_URL="postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# Direct (unpooled) connection — used ONLY by the Prisma CLI (migrate/studio) so
# migrations bypass the pooler. See prisma.config.ts. If db.<ref>.supabase.co is
# IPv6-only and won't connect, use the Session-pooler URL (IPv4) here instead.
DIRECT_URL="postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# Upstash Redis — legacy BullMQ queue. Superseded by Amazon SQS (docs/19/20); kept
# only so the app boots until the SQS worker lands in Phase 17. Remove then.
UPSTASH_REDIS_URL="rediss://default:password@example.upstash.io:6379"

# Clerk (auth) — get from https://dashboard.clerk.com. Use a test-mode instance
# until Phase 25 production cutover.
CLERK_SECRET_KEY="sk_test_placeholder"
CLERK_WEBHOOK_SECRET="whsec_placeholder"
# Optional: Clerk's JWKS public key (PEM) for networkless JWT verification. When
# unset, the guard fetches JWKS from Clerk's API using CLERK_SECRET_KEY instead.
CLERK_JWT_KEY=""

# Gemini Vision / Text (AI analysis pipeline, wired in Phase 17)
GEMINI_API_KEY="placeholder"

# Image storage — wired in Phase 16 as an S3-compatible StorageService.
# DEV: Supabase Storage (private bucket + S3 access keys from Storage → S3 Connection).
# PROD: Cloudflare R2 — same 5 vars, only the values change (endpoint/region/keys/bucket).
# These CLOUDFLARE_R2_* placeholders are replaced by generic STORAGE_* vars in Phase 16.
CLOUDFLARE_R2_ACCOUNT_ID="placeholder"
CLOUDFLARE_R2_ACCESS_KEY_ID="placeholder"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="placeholder"
CLOUDFLARE_R2_BUCKET_NAME="skincoach-scans"

# App
PORT=3000
NODE_ENV=development
